#compdef nut
# Generated by nut completion (protocol 1). Do not edit: run `nut completion install`.
# Each <TAB> asks the `nut` on your PATH, so completion always matches the installed binary.

_nut() {
  local -a lines fields groups
  local -A arrays
  local line value help group suffix array header tag ret=1

  lines=(${(f)"$(command nut __complete zsh --protocol 1 --suffix "$SUFFIX" -- \
    "${(@Q)words[1,CURRENT-1]}" "${(Q)PREFIX}" 2>/dev/null)"})
  (( $#lines )) || return 1

  # Nut-scoped presentation defaults, applied only where you have set no style.
  if ! zstyle -m ":completion:${curcontext}:descriptions" format '*'; then
    local locale use_ascii=0
    if [[ ${TERM-} == dumb ]]; then
      use_ascii=1
    else
      if [[ -n ${LC_ALL-} ]]; then
        locale=$LC_ALL
      elif [[ -n ${LC_CTYPE-} ]]; then
        locale=$LC_CTYPE
      elif [[ -n ${LANG-} ]]; then
        locale=$LANG
      fi
      locale=${(L)locale}
      if [[ $locale != *utf-8* && $locale != *utf8* ]]; then
        use_ascii=1
      fi
    fi
    if (( use_ascii )); then
      if [[ -n ${NO_COLOR-} ]]; then
        header='%B== %d ==%b'
      else
        header='%B%F{cyan}== %d ==%f%b'
      fi
    else
      if [[ -n ${NO_COLOR-} ]]; then
        header='%B── %d ──%b'
      else
        header='%B%F{cyan}── %d ──%f%b'
      fi
    fi
    zstyle ':completion:*:*:nut:*:descriptions' format "$header"
  fi
  zstyle -m ":completion:${curcontext}:" group-name '*' ||
    zstyle ':completion:*:*:nut:*' group-name ''

  for line in $lines; do
    case $line in
      ('!prefix '<->) compset -P ${line#!prefix }; continue ;;
      ('!dirs')       _files -/ && ret=0; continue ;;
      ('!files')      _files && ret=0; continue ;;
      ('!files '*)    _files -g "${line#!files }" && ret=0; continue ;;
      ('!message '*)  _message -r "${${line#!message }//\%/%%}"; continue ;;
      ('!'*)          continue ;;  # a directive from a newer nut: ignore it
    esac
    fields=("${(@ps:\t:)line}")
    value=${fields[1]//:/\\:} help=$fields[2] group=${fields[3]:-values} suffix=${fields[4]:-space}
    array=$arrays[$group/$suffix]
    if [[ -z $array ]]; then
      array=_nut_group_$#groups
      arrays[$group/$suffix]=$array
      groups+=("$group/$suffix")
      local -a $array
    fi
    set -A $array "${(@P)array}" "$value${help:+:$help}"
  done

  for group in $groups; do
    array=$arrays[$group]
    suffix=${group##*/} group=${group%/*}
    tag=${(L)group}
    tag=${tag//[^[:alnum:]]/-}
    while [[ $tag == *--* ]]; do
      tag=${tag//--/-}
    done
    tag=${tag#-}
    tag=${tag%-}
    if [[ $suffix == nospace ]]; then
      _describe -V -t "nut-${tag}" "$group" $array -S '' && ret=0
    else
      _describe -V -t "nut-${tag}" "$group" $array && ret=0
    fi
  done
  return ret
}

if [[ $zsh_eval_context[-1] == loadautofunc ]]; then
  _nut "$@"
else
  compdef _nut nut
fi
