#compdef nut
# Generated by nut completion (protocol 2). Do not edit: run `nut completion install`.
# Each <TAB> asks the `nut` on your PATH, so completion always matches the installed binary.

_nut() {
  local -a lines group_order
  local -A group_headings
  local line rest tag heading value display space tmp
  local ret=1 cur_group=''

  lines=(${(f)"$(command nut __complete zsh --protocol 2 --suffix "$SUFFIX" --columns "$COLUMNS" -- \
    "${(@Q)words[1,CURRENT-1]}" "${(Q)PREFIX}" 2>/dev/null)"})
  (( $#lines )) || return 1

  local i=0
  for line in $lines; do
    case $line in
      ('!prefix '<->) compset -P ${line#!prefix }; continue ;;
      ('!dirs') _files -/ && ret=0; continue ;;
      ('!files') _files && ret=0; continue ;;
      ('!files '*) _files -g "${line#!files }" && ret=0; continue ;;
      ('!message '*) _message -r "${line#!message }"; ret=0; continue ;;
      ('!hint '*) {
        rest=${line#!hint }
        value=${rest%%$'\t'*}; display=${rest#*$'\t'}
        value=${value//\%/%%}; display=${display//\%/%%}
        if (( ${+NO_COLOR} )) && [[ -n "$NO_COLOR" ]]; then
          _message -r "$value  $display"
        else
          _message -r "%B%F{cyan}$value%f%b  %{\e[2m%}$display%{\e[0m%}"
        fi
        ret=0; continue
      } ;;
      ('!group '*) {
        rest=${line#!group }
        tag=${rest%%$'\t'*}; heading=${rest#*$'\t'}
        heading=${heading//\%/%%}
        cur_group=$tag
        if (( ! ${+group_headings[$tag]} )); then
          group_headings[$tag]=$heading
          group_order+=("$tag")
          (( ++i ))
          eval "local -a _nut_v_$i _nut_d_$i _nut_s_$i"
          eval "_nut_g_$i=\$tag"
        fi
        continue
      } ;;
      ('!'*) continue ;;  # a directive from a newer nut: ignore it
    esac
    [[ -z $cur_group ]] && continue
    value=${line%%$'\t'*}
    tmp=${line#*$'\t'}; display=${tmp%%$'\t'*}; space=${tmp#*$'\t'}
    # Find the group index.
    local gi=1
    while (( gi <= i )); do
      eval "local _g=\$_nut_g_$gi"
      [[ $_g == $cur_group ]] && break
      (( gi++ ))
    done
    (( gi > i )) && continue
    # Append without word splitting or globbing.
    eval "_nut_v_$gi+=(\"\$value\")"
    if [[ -n $display ]]; then
      eval "_nut_d_$gi+=(\"\$display\")"
    else
      eval "_nut_d_$gi+=(\"\$value\")"
    fi
    eval "_nut_s_$gi+=(\"\$space\")"
  done

  # Nut-scoped presentation defaults, applied only where you have set no style.
  local style_pat=':completion:*:*:nut:*:nut-*'
  local own_pat=0
  if zstyle -L "$style_pat" 2>/dev/null | grep -q .; then
    own_pat=1
  fi
  local color_off=0
  (( ${+NO_COLOR} )) && [[ -n "$NO_COLOR" ]] && color_off=1
  {
    if (( ! own_pat )); then
      if ! zstyle -m ":completion:${curcontext}:descriptions" format '*'; then
        if (( color_off )); then
          zstyle "$style_pat" format '%d'
        else
          zstyle "$style_pat" format '%B%F{cyan}%d%f%b'
        fi
      fi
      zstyle -m ":completion:${curcontext}:" group-name '*' || zstyle "$style_pat" group-name ''
      if (( ! color_off )); then
        if ! zstyle -L 2>/dev/null | grep ':nut:' | grep -q 'list-colors'; then
          zstyle "$style_pat" list-colors '=(#b)(  )(?*[^ ])(  ##)(*)=0=0=1=0=2'
        fi
      fi
    fi

    local gi=1
    for tag in $group_order; do
      heading=${group_headings[$tag]}
      eval "local -a _vals=(\"\${_nut_v_$gi[@]}\") _disps=(\"\${_nut_d_$gi[@]}\") _sps=(\"\${_nut_s_$gi[@]}\")"
      local k=1 n=$#_vals
      while (( k <= n )); do
        local m=$k cur_sp=${_sps[$k]}
        while (( m < n )) && [[ ${_sps[$((m+1))]} == $cur_sp ]]; do (( m++ )); done
        local -a run_vals run_disps
        run_vals=("${_vals[$k,$m]}")
        run_disps=("${_disps[$k,$m]}")
        if [[ $cur_sp == nospace ]]; then
          _wanted -V "$tag" expl "$heading" compadd -l -d run_disps -a run_vals -S '' && ret=0
        else
          _wanted -V "$tag" expl "$heading" compadd -l -d run_disps -a run_vals && ret=0
        fi
        k=$((m+1))
      done
      (( gi++ ))
    done
  } always {
    (( ! own_pat )) && zstyle -d "$style_pat" 2>/dev/null
  }
  return ret
}

if [[ $zsh_eval_context[-1] == loadautofunc ]]; then
  _nut "$@"
else
  compdef _nut nut
fi
